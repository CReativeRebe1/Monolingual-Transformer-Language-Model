# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
*.ipynb_checkpoints/

# The Kaggle working notebook. Every cell of it is committed verbatim in
# notebooks/phase2_kaggle.md, which is the reproducible artifact; the .ipynb adds only stored
# output blobs and JSON diffs nobody can read in a review.
notebooks/*.ipynb

# --- Large artifacts: Drive, never git (spec requirement) ---
# Raw / intermediate corpora
*/data/raw/**
*/data/shards/**
*/data/interim/**
*.jsonl.gz
*.jsonl.zst
*.warc
*.warc.gz

# Encoded training corpora (memmap bin/idx — large, regenerable from tokenizer + splits)
*.bin
*.idx

# The Kaggle upload archive built by scripts/pack_kaggle.py -- 1.5 GB, and fully regenerable from
# the encoded corpora plus the code that is already tracked.
dist/

# Model checkpoints
*.pt
*.pth
*.ckpt
*.safetensors

# Downloaded external corpora / caches
data_cache/
.cache/
hf_cache/

# fastText pretrained LID model (downloaded utility, not a project artifact)
lid.176*.bin
lid.176*.ftz

# OCR intermediate scans
*/data/ocr_raw/**

# --- Logs / experiment tracking ---
wandb/
*.log

# Smoke runs are throwaway 50-step shape/resume checks, written to their own subdirectory so they
# cannot append into the real run's permanently-append-only log.
*/train/logs/smoke/
*/train/checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Frontier / crawl state (large sqlite dbs, kept local not in git) ---
*/data/crawl_state.sqlite3
*/data/crawl_state.sqlite3-*
*.pid

# --- scripts/reproduce.sh output: regenerable by re-running the script, never committed ---
scripts/sample_data/demo_run/

# --- Intermediate tokenizer_sweep.py candidates (regenerable; only the selected model/vocab
# pair + sweep_results.json are committed) ---
*/tokenizer/sweep/

# Local strategy notes -- never published
suggestion.md
FAST_HINDI_CRAWLER_IMPLEMENTATION_PLAN.md
*/data/fast_state.sqlite3
*/data/fast_state.sqlite3-*

# --- Secrets: never commit HF tokens or env files ---
.env
.env.*
*token*.txt
*.token
hf_token*

# Downloaded-corpus resume state (large sqlite, regenerable)
*/data/downloaded_state.sqlite3
*/data/downloaded_state.sqlite3-*

# Cached manual dedup index (regenerable via --rebuild-index)
*/data/dup_index.npz

# --- Final splits: multi-GB, kept on Drive, never in git ---
# hindi/data/splits is 5.1 GB and nepali/data/splits 7.5 GB at the final corpus size (3.6M and
# 5.5M documents). They are regenerable from the raw shards + interim files via
#   python scripts/build_corpus.py --lang <lang> --from-interim
# and are uploaded with
#   python scripts/upload_to_drive.py --lang <lang> --what cleaned
# The committed record of what they contain is <lang>/data/stats.json, <lang>/data/encoded/
# encoding.json (authoritative token counts) and result.md.
*/data/splits/*.txt
*/data/splits/*.manifest.jsonl

# --- Extras: regenerable diagnostics, not part of the submission ---
# scripts/tokenizer_comparison.py dumps every piece of ten documents under both tokenizers (~300 KB
# of raw segmentations). The finding it supports is summarised in report/phase1.md; the dump itself
# is reproducible in seconds and would only bloat the repo.
report/tables/

# --- LaTeX report source + build artifacts (the PDF is what gets submitted) ---
*.tex
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# --- Phase 3: reasoning finetuning ---
# Finetuned checkpoints go to Drive (the *.pt rule already covers them; the directory rule also
# keeps optimizer-only leftovers out). Smoke runs are throwaway shape/resume checks. Per-example
# evaluation rows are regenerable in minutes from a checkpoint and are uploaded with it.
# The 19 MB train split is regenerable byte-for-byte by generate.py and lives on Drive; val and the
# four test splits (~1 MB each) are committed so the evaluated examples can be read in the repo.
*/reasoning/checkpoints/
*/reasoning/logs/smoke/
*/reasoning/results/rows/
*/reasoning/data/train.jsonl

# --- Bonus: NoPE ablation ---
# The checkpoint goes to Drive; smoke runs are throwaway.
*/nope/checkpoints/
*/nope/logs/smoke/

# --- Phase-2 and Phase-3 training logs: kept, and kept LAST ---
# These ARE the deliverable -- the report's loss curves are plotted from train_log.jsonl and
# train.log is its human-readable mirror. Both are append-only and small (a few hundred KB for a
# full run). The negations must sit at the very end of this file: gitignore is last-match-wins, and
# the LaTeX `*.log` rule above would otherwise re-exclude train.log after an earlier negation
# un-excluded it -- which is exactly what `git check-ignore -v` reported the first time.
!*/train/logs/train.log
!*/train/logs/train_log.jsonl
!*/train/logs/summary.json
!*/reasoning/logs/*/train.log
!*/reasoning/logs/*/train_log.jsonl
!*/reasoning/logs/*/summary.json

#need combined pdf so only phase 3 report not neeeded as we already have phase3.md version
phase3_only.pdf
!*/nope/logs/train.log
!*/nope/logs/train_log.jsonl
!*/nope/logs/summary.json
